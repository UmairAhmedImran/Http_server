CC = @CC@
CFLAGS = @CFLAGS@ -I@srcdir@/include
LDFLAGS = @LDFLAGS@
PREFIX = @prefix@
BINDIR = @bindir@
SYSCONFDIR = @sysconfdir@
LOGDIR = @localstatedir@/log

SRC = src/http.c src/server.c src/backend.c src/main.c src/logging.c src/config.c
OBJ = $(SRC:.c=.o)
OUT = build/server

VERSION = @VERSION@

all: $(OUT)

$(OUT): $(OBJ)
	@mkdir -p build
	$(CC) $(CFLAGS) $(LDFLAGS) $(OBJ) -o $(OUT) -lpthread

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

install: $(OUT)
	@echo "Installing load balancer..."
	@mkdir -p $(DESTDIR)$(BINDIR)
	@mkdir -p $(DESTDIR)$(SYSCONFDIR)
	@mkdir -p $(DESTDIR)$(LOGDIR)
	@install -m 755 $(OUT) $(DESTDIR)$(BINDIR)/httplb
	@if [ ! -f $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf ]; then \
		install -m 644 config.example $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf.example; \
		echo "Installed example config to $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf.example"; \
	fi
	@echo "Installation complete!"
	@echo "Binary: $(DESTDIR)$(BINDIR)/httplb"
	@echo "Config: $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf.example"
	@echo ""
	@echo "To use:"
	@echo "  1. Copy $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf.example to $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf"
	@echo "  2. Edit $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf with your backend servers"
	@echo "  3. Run: httplb -c $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf"

uninstall:
	@echo "Uninstalling load balancer..."
	rm -f $(DESTDIR)$(BINDIR)/httplb
	rm -f $(DESTDIR)$(SYSCONFDIR)/loadbalancer.conf.example
	@echo "Uninstallation complete!"

clean:
	rm -rf build
	rm -f $(OBJ)
	rm -f server.log

distclean: clean
	rm -f Makefile
	rm -f config.log
	rm -f config.status
	rm -f *.o

dist: distclean
	@VERSION=$(VERSION); \
	DIRNAME=$$(basename $$(pwd)); \
	PARENT=$$(dirname $$(pwd)); \
	TARBALL=$$DIRNAME-$$VERSION.tar.gz; \
	cd $$PARENT && \
	tar --exclude='.git' \
	    --exclude='build' \
	    --exclude='server.log' \
	    --exclude='config' \
	    --exclude='*.o' \
	    -czf $$TARBALL $$DIRNAME && \
	echo "Created distribution: $$PARENT/$$TARBALL"

debug: CFLAGS += -DDEBUG -g
debug: all

release: CFLAGS += -O2 -DNDEBUG
release: all

.PHONY: all install uninstall clean distclean dist debug release

